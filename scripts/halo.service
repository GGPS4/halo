[Unit]
Description=Halo cocktail maker
After=graphical.target network-online.target
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__HALO_DIR__
Environment=SDL_VIDEODRIVER=kmsdrm
ExecStart=__HALO_DIR__/.venv/bin/python -m halo
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
